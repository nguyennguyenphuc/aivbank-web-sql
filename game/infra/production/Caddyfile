{
	auto_https off
	admin off
}

:8080 {
	root * /srv
	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	handle /api/* {
		reverse_proxy api:3001
	}

	@immutable path_regexp immutable ^/assets/.+-[A-Za-z0-9_-]{8,}\.(?:css|js|mjs|woff2?|png|jpe?g|svg|webp|avif)$
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	@revalidate path / /index.html /sw.js /service-worker.js /manifest.webmanifest
	header @revalidate Cache-Control "no-cache, no-store, must-revalidate"

	handle {
		try_files {path} /index.html
		file_server
	}
}
