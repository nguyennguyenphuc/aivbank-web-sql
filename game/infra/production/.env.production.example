# Compose release identity. Use the exact approved Git commit; never use latest.
IMAGE_TAG=<full-git-sha>
RELEASE_SHA=<full-git-sha>

# External runtime configuration and secret files (0600, outside the release).
MATCH3_ENV_FILE=${HOME}/Services/match3-h5/shared/.env.production
POSTGRES_PASSWORD_FILE=${HOME}/Services/match3-h5/shared/postgres-password
MATCH3_DB_PASSWORD_FILE=${HOME}/Services/match3-h5/shared/match3-app-password
REDIS_ACL_FILE=${HOME}/Services/match3-h5/shared/redis-users.acl
REDIS_PASSWORD_FILE=${HOME}/Services/match3-h5/shared/redis-password
CLOUDFLARED_CONFIG_FILE=${HOME}/Services/match3-h5/shared/cloudflared/config.yml
CLOUDFLARED_CREDENTIALS_FILE=${HOME}/Services/match3-h5/shared/cloudflared/credentials.json

# Host bind mount outside the Podman VM; keep custom-format dumps here.
BACKUP_DIR=${HOME}/Services/match3-h5/backups

# Non-secret database identifiers.
POSTGRES_DB=match3_h5
# Bootstrap role only. The external DATABASE_URL must use a separately created,
# non-superuser match3_app role after the first-deploy grant step.
POSTGRES_ADMIN_USER=match3_admin
