{
  "name": "jelly-trail-academy-h5",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web:wait\"",
    "dev:web": "vite --port=3000 --host=0.0.0.0",
    "dev:web:wait": "tsx scripts/wait-for-api.ts && npm run dev:web",
    "dev:api": "tsx watch --tsconfig server/tsconfig.json server/src/main.ts",
    "build": "npm run build:web && npm run build:api",
    "build:web": "vite build",
    "build:api": "tsc -p server/tsconfig.json --noEmit && esbuild server/src/main.ts --bundle --platform=node --packages=external --format=esm --sourcemap --outfile=server/dist/main.js",
    "start:api": "node server/dist/main.js",
    "preview": "vite preview --port=3000 --host=0.0.0.0",
    "clean": "rm -rf dist server/dist coverage",
    "lint": "tsc --noEmit && tsc -p server/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:smoke": "vitest run tests/smoke",
    "test:engine": "vitest run tests/engine",
    "test:contracts": "vitest run tests/engine/content-parity.test.ts",
    "test:integration": "vitest run tests/integration",
    "test:auth": "vitest run tests/integration/auth",
    "test:economy": "vitest run tests/integration/economy",
    "test:commerce": "vitest run tests/integration/commerce",
    "test:leaderboards": "vitest run tests/integration/leaderboards",
    "test:liveops": "vitest run tests/integration/liveops",
    "test:analytics": "vitest run tests/analytics",
    "test:classroom": "vitest run tests/classroom",
    "test:exports": "vitest run tests/exports",
    "test:e2e": "tsx scripts/run-browser-gates.ts e2e",
    "qa:a11y": "tsx scripts/run-browser-gates.ts a11y",
    "qa:perf": "tsx scripts/run-browser-gates.ts perf",
    "qa:security": "tsx scripts/run-browser-gates.ts security",
    "qa:backup-restore": "tsx scripts/verify-backup-restore.ts",
    "sim:levels": "tsx scripts/simulate-levels.ts",
    "artifact:candy": "python3 scripts/build-candy-artifact.py",
    "data:import": "tsx scripts/import-jelly-dataset.ts --reset",
    "export:csv": "tsx scripts/export-csv.ts",
    "export:sqlite": "tsx scripts/export-sqlite.ts --overwrite",
    "export:verify": "tsx scripts/verify-jelly-exports.ts",
    "db:migrate": "tsx server/src/database/migrate.ts up",
    "db:rollback": "tsx server/src/database/migrate.ts down",
    "db:seed": "tsx server/src/database/seed.ts",
    "db:seed-demo": "tsx scripts/seed-demo-accounts.ts",
    "db:backup": "tsx scripts/backup-database.ts",
    "db:restore": "tsx scripts/restore-database.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-fastify": "^12.0.1",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "fastify": "^5.12.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "redis": "^6.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "@types/pg": "^8.15.5",
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "^10.0.5",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.11"
  }
}
