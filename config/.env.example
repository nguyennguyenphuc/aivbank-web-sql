# AIV Bank — mẫu cấu hình ứng dụng
#
# Chép thành `app/config/app.env` rồi sửa. File thật KHÔNG vào git
# (xem .gitignore: `app/config/*` trừ chính file này).
#
# Mọi biến đều có mặc định an toàn trừ những chỗ ghi BẮT BUỘC. Mặc định được
# tính từ vị trí thư mục `app/`, nên chuyển `app/` sang chỗ khác vẫn chạy.

# ===========================================================================
# 1. BẮT BUỘC
# ===========================================================================

# Địa chỉ trang web sẽ gọi API. Bỏ trống = chỉ cho phép loopback, tức là học
# viên ở xa KHÔNG đăng nhập được mà không có lỗi rõ ràng nào ở phía server.
# Nhiều địa chỉ thì phân tách bằng dấu phẩy.
AIVB_CORS_ORIGINS=https://aivbank.duckdns.org

# Bật khi phục vụ qua HTTPS. Cookie phiên mang tiền tố `__Host-` nên trình
# duyệt TỪ CHỐI nhận nó qua HTTP — đặt sai giá trị này thì triệu chứng là
# "đăng nhập xong vẫn như chưa đăng nhập", không phải một thông báo lỗi.
AIVB_COOKIE_SECURE=1

# ===========================================================================
# 2. PostgreSQL
# ===========================================================================
# Hai database VẬT LÝ tách rời. `aivb_student` không chứa 23 bảng giảng viên
# lẫn cột `raw_account_transaction.dirty_flag` — chúng không tồn tại chứ không
# phải bị giấu. Xem ARCHITECTURE.md mục "Vì sao hai database".

AIVB_PG_HOST=127.0.0.1
AIVB_PG_PORT=5432
AIVB_PG_DB_STUDENT=aivb_student
AIVB_PG_DB_INSTRUCTOR=aivb_instructor
AIVB_PG_USER_STUDENT=aivb_api_student
AIVB_PG_USER_INSTRUCTOR=aivb_api_instructor
AIVB_PG_SCHEMA=aivb

# Mặc định `app/config/pg_secrets.env`. Định dạng: `pw_api_s=<mật khẩu>` mỗi
# dòng, chú thích sau dấu cách. Mật khẩu là phần TRƯỚC dấu cách đầu tiên.
AIVB_PG_PASSWORD_FILE=

# `disable` là đúng khi API và PostgreSQL cùng một máy (đi qua loopback).
# Người dùng BI từ xa thì dùng `require` — đó là phía client, không phải đây.
AIVB_PG_SSLMODE=disable
AIVB_PG_CONNECT_TIMEOUT_S=5
AIVB_PG_APPLICATION_NAME=aivbank-api

# `C` là BẮT BUỘC, không phải tuỳ chọn. Guard tái lập nguyên văn thông báo lỗi
# của PostgreSQL để một cột bị giấu không phân biệt được với một cột gõ sai.
# Đổi giá trị này là phá tính chất đó — học viên dò được sự tồn tại của cột.
AIVB_PG_LC_MESSAGES=C

AIVB_PG_WORK_MEM=64MB
AIVB_PG_TEMP_FILE_LIMIT=2GB
AIVB_PG_PARALLEL_WORKERS=2

# ===========================================================================
# 3. Frontend
# ===========================================================================
# ĐÂY LÀ ĐIỂM THAY THẾ FRONTEND. Mặc định `app/frontend/` (JS thuần, không cần
# build). Muốn dùng React/Vue/Svelte: build ra một thư mục rồi trỏ biến này vào
# đó — không sửa một dòng backend nào.
#
# Hợp đồng giữa hai bên là `app/backend/API_CONTRACT.md`, đặc biệt mục 9
# "Rules the frontend MUST follow".
AIVB_FRONTEND_DIR=

# ===========================================================================
# 4. Hợp đồng dữ liệu
# ===========================================================================
# Nguồn sự thật về cột nào vai trò nào được thấy. Mặc định là bản sao trong
# `app/backend/contract/`. Đồng bộ lại sau khi chủ sở hữu phát hành package
# mới: `python app/database/sync_contract.py`
AIVB_CONTRACT_PATH=
AIVB_OWNER_CONFIG_PATH=

# ===========================================================================
# 5. Phiên và chặn đăng nhập sai
# ===========================================================================
# KHÔNG có biến trỏ tới kho mật khẩu, và đó là chủ đích: mật khẩu nằm trong
# `pg_authid` do chính PostgreSQL giữ. Ứng dụng không băm và không lưu một bản
# sao nào — `verify_password` mở một kết nối bằng chính vai trò của người đó.
#
# Phiên, chặn đăng nhập sai và hồ sơ nằm trong database `aivb_app` (mục 2).
#
# Log audit thì vẫn là file: nó ghi nguyên văn câu truy vấn kèm ai chạy, nên
# `.gitignore` chặn `audit.jsonl` ở mọi nơi trong cây.
AIVB_AUDIT_LOG_PATH=

AIVB_SESSION_IDLE_S=1800
AIVB_SESSION_ABSOLUTE_S=43200
AIVB_LOGIN_FAIL_THRESHOLD=5
AIVB_LOGIN_IP_FAIL_THRESHOLD=20
AIVB_LOGIN_LOCK_BASE_S=30
AIVB_LOGIN_LOCK_MAX_S=900

# ===========================================================================
# 6. Giới hạn truy vấn
# ===========================================================================
# Đây là hàng rào chịu tải của cả lớp dùng chung một máy chủ, không phải
# tinh chỉnh hiệu năng.

AIVB_QUERY_TIMEOUT_S=15
AIVB_MAX_ROWS=10000
AIVB_MAX_SQL_CHARS=20000
AIVB_MAX_RESPONSE_BYTES=8388608
AIVB_MAX_CONCURRENT_QUERIES=4
AIVB_MAX_QUEUED_QUERIES=16
AIVB_ADMISSION_WAIT_S=10

AIVB_LOG_LEVEL=INFO

# ===========================================================================
# 9. BỘ DỮ LIỆU (thêm 2026-08-19)
# ===========================================================================
# App phục vụ nhiều bộ dữ liệu. Bỏ trống = chỉ `aivb`, và khi đó mọi biến
# AIVB_PG_* ở trên vẫn là nguồn cấu hình duy nhất — một bản triển khai đang
# chạy không phải sửa gì.
#
# Mỗi bộ dữ liệu là một database + schema + hợp đồng cột riêng. Chúng KHÔNG
# dùng chung catalog: đó là thứ ngăn tên bảng của bộ này lọt sang bộ kia.
AIVB_DATASETS=aivb,scm

# --- Finance Banking (AIV Bank) -------------------------------------------
# Lấy mặc định từ AIVB_PG_* ở mục 2, chỉ cần đặt nhãn hiển thị.
AIVB_DS_AIVB_LABEL=Finance Banking

# --- Supply Chain ----------------------------------------------------------
# MỘT database, không phải hai. AIV Bank tách đôi vì trong dữ liệu có bảng đáp
# án; SupplyChain không có bảng nào như vậy (đáp án của nó nằm ở labs/vn/*.py,
# outputs/ và mục 6.7/10 của MO-TA-BO-DU-LIEU.md — đều là file). Nhân đôi 9 GB
# để giấu một thứ không nằm trong dữ liệu là vô nghĩa.
AIVB_DS_SCM_LABEL=Supply Chain
AIVB_DS_SCM_DB_STUDENT=scm
AIVB_DS_SCM_SCHEMA=scm
AIVB_DS_SCM_USER_STUDENT=scm_api
AIVB_DS_SCM_CONTRACT_PATH=backend/contract/scm-column-contract.json
# Tiền của bộ này là USD có phần thập phân, khác VND số nguyên của AIV Bank.
AIVB_DS_SCM_CURRENCY=USD_DEC
# Khoá trong config/pg_secrets.env.
AIVB_DS_SCM_SECRET_KEY_STUDENT=pw_scm_api
