# Bien moi truong cua game (service `game-migrate` + `game-api`), va la noi
# backend doc AIVB_SSO_SECRET. Sinh file that bang:
#
#     .\scripts\Enable-Game.ps1 -Apply
#
# KHONG viet chu thich sau gia tri tren cung dong: docker `env_file` coi ca
# phan do la gia tri.

# postgres://candy_app:<pw_candy_app trong pg_secrets.env>@postgres:5432/candy_game
DATABASE_URL=postgres://candy_app:CHANGE_ME@postgres:5432/candy_game
REDIS_URL=redis://redis:6379

# Moi khoa >= 32 ky tu, DOC LAP voi nhau.
SESSION_SECRET=CHANGE_ME_32_CHARS_MINIMUM_xxxxxxxx
TELEMETRY_HASH_SECRET=CHANGE_ME_ANOTHER_32_CHARS_xxxxxxx
# Khoa HMAC ky ve SSO - backend AIV Bank va game-api cung doc dong nay.
AIVB_SSO_SECRET=CHANGE_ME_THIRD_32_CHARS_xxxxxxxxxx

# Moi origin ma trinh duyet dung de mo AIV Bank, cach nhau bang dau phay.
WEB_ORIGIN=https://aivbank.duckdns.org,http://127.0.0.1:8000,http://localhost:8000
